<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".schedule.ScheduleFragment"
    android:background="#fff">

    <!-- Fila de botones: Eliminar | Agregar | Exportar PDF -->

    <Button
        android:id="@+id/btnDeleteRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Eliminar fila"
        android:backgroundTint="#222E50"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnAddRow"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"/>

    <Button
        android:id="@+id/btnAddRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Agregar fila"
        android:backgroundTint="#222E50"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/btnDeleteRow"
        app:layout_constraintStart_toEndOf="@id/btnDeleteRow"
        app:layout_constraintEnd_toStartOf="@+id/btnExportPdf"
        android:layout_marginEnd="2dp"/>

    <Button
        android:id="@+id/btnExportPdf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Exportar PDF"
        android:backgroundTint="#C42021"
        android:textSize="12sp"
        android:drawableStart="@drawable/ic_picture_as_pdf"
        android:drawablePadding="4dp"
        app:layout_constraintTop_toTopOf="@id/btnAddRow"
        app:layout_constraintStart_toEndOf="@id/btnAddRow"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnDeleteRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </HorizontalScrollView>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>